{
  "lock": true,
  "nodeModulesDir": "none",
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "strictBindCallApply": true
  },
  "tasks": {
    "generate": "cd ../dev && deno run --allow-read --allow-write generate.ts",
    "run": "deno run -A main.ts",

    "run:test": "deno task generate && deno test --allow-all --trace-leaks --watch",
    "run:dev": "deno task generate && deno run -A --watch main.ts",
    "run:live": "deno task generate && deno task run",

    "run:full": "deno install && deno task generate && deno task run"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/http": "jsr:@std/http@1",
    "$std/": "https://deno.land/std@0.216.0/",
    "@db/sqlite": "jsr:@db/sqlite@^0.12.0",
    "@twurple/api": "npm:@twurple/api@^7.2.0",
    "@twurple/auth": "npm:@twurple/auth@^7.2.0",
    "@twurple/chat": "npm:@twurple/chat@^7.2.0",
    "@twurple/eventsub-ws": "npm:@twurple/eventsub-ws@^7.2.0",
    "chalk": "npm:chalk@^5.3.0",
    "discord.js": "npm:discord.js@^14.16.3",
    "obs-websocket-js": "npm:obs-websocket-js@^5.0.6"
  },
  "fmt": {
    "lineWidth": 120,
    "semiColons": false,
    "singleQuote": true,
    "indentWidth": 4,
    "trailingCommas": "never"
  }
}
